{
  "name": "megascans-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Bridgeでダウンロード済みのMegascansアセットを検索・閲覧するデスクトップアプリ",
  "main": "dist/main/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "vite",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc --project tsconfig.main.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.main.json --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
