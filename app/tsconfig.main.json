    "moduleResolution": "Node",
    "verbatimModuleSyntax": false,
    "outDir": "dist/main",
    "rootDir": "src",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/main", "src/preload", "src/shared"],
  "exclude": ["src/preload/api.d.ts"]
}
